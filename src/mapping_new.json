          "type": "custom",
          "char_filter": [],
          "filter": ["trim", "lowercase"]
        }
      },
      "analyzer": {
        "mz_russian": {
          "tokenizer": "standard",
          "filter": [
            "lowercase",
            "russian_stop",
            "russian_keywords",
            "russian_stemmer"
          ]
        }
      },
      "filter": {
