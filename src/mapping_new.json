        "russian_stemmer": {
          "type": "stemmer",
          "language": "russian"
        }
      }
    }
  },
  "mappings": {
    "properties": {
      "version": {
        "type": "integer",
        "index": false
      },
      "version_ts": {
        "type": "date"
      },
      "doc_count": {
        "type": "integer"
      },
      "progress": {
        "type": "object"
      },
      "articles": {
        "type": "wildcard"
      },
      "case_category": {
        "type": "keyword",
        "normalizer": "lowercase"
      },
      "case_hidden": {
        "type": "boolean"
      },
      "case_number": {
        "type": "keyword"
      },
      "case_subcategory": {
        "type": "keyword",
        "normalizer": "lowercase"
      },
      "case_type": {
        "type": "keyword"
      },
      "censorship": {
        "type": "text",
        "analyzer": "russian",
        "fields": {
          "keyword": {
            "type": "keyword",
            "normalizer": "lowercase"
          }
        }
      },
      "court_code": {
        "type": "keyword"
      },
      "tag": {
        "type": "keyword"
      },
      "court_name": {
        "type": "keyword"
      },
      "date_reg": {
        "type": "date",
        "ignore_malformed": true
      },
      "date_result": {
        "type": "date",
        "ignore_malformed": true
      },
      "date_onhold_defendant_wanted": {
        "type": "date",
        "ignore_malformed": true
      },
      "date_onhold_defendant_located": {
        "type": "date",
        "ignore_malformed": true
      },
      "date_onhold_defendant_military": {
        "type": "date",
        "ignore_malformed": true
      },
      "defendants": {
        "type": "text",
        "analyzer": "russian",
        "fields": {
          "keyword": {
            "type": "wildcard"
          }
        }
      },
      "first_case_number": {
        "type": "keyword"
      },
      "first_court_name": {
        "type": "keyword"
      },
      "first_judge": {
        "type": "keyword"
      },
      "id_final": {
        "type": "keyword"
      },
      "id_uid": {
        "type": "keyword"
      },
      "instance": {
        "type": "keyword"
      },
      "judge": {
        "type": "keyword"
      },
      "link": {
        "type": "keyword",
        "index": false
      },
      "participants": {
        "type": "text",
        "analyzer": "russian",
        "fields": {
          "keyword": {
            "type": "wildcard"
          }
        }
      },
      "region": {
        "type": "keyword"
      },
      "result": {
        "type": "keyword",
        "normalizer": "lowercase"
      },
      "case_state": {
        "type": "keyword",
        "normalizer": "lowercase"
      },
      "uuid": {
        "type": "keyword"
      },
      "html_files": { "type": "keyword", "index": false },
      "path_manifest": { "type": "keyword", "index": false },
      "documents": {
        "type": "nested",
        "properties": {
          "filename": {
            "type": "keyword"
          },
          "date": {
            "type": "date",
            "ignore_malformed": true
          },
          "name": {
            "type": "keyword"
          },
          "text": {
            "type": "text",
            "analyzer": "mz_russian"
          }
        }
      }
    }
  }
}
